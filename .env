
PROMETHEUS_VERSION=v3.9.1
ALERT_MANAGER_VERSION=v0.31.1
GRAFANA_VERSION=12.3.3
LOKI_VERSION=3.6.5
GRAFANA_RENDERER_VERSION=v5.5.1
THANOS_VERSION=v0.41.0
VICTORIA_METRICS_VERSION=v1.96.0
GF_AUTH_BASIC_ENABLED=false
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=false
GF_SECURITY_ANGULAR_SUPPORT_ENABLED=false
GF_SERVER_ENABLE_GZIP=true
SCYLLA_VERSION=2025.4
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERT_MANAGER_RULE_CONFIG=./prometheus/rule_config.yml
PROMETHEUS_RULES=/home/marcinsz/scylla-monitoring/prometheus/prom_rules/:/etc/prometheus/prom_rules/
BIND_ADDRESS=
SCYLLA_TARGET_FILE=/home/marcinsz/scylla-monitoring/prometheus/scylla_servers.yml:/etc/scylla.d/prometheus/targets/scylla_servers.yml
SCYLLA_MANGER_TARGET_FILE=/home/marcinsz/scylla-monitoring/prometheus/scylla_manager_servers.example.yml:/etc/scylla.d/prometheus/targets/scylla_manager_servers.yml
SCYLLA_MANGER_AGENT_TARGET_FILE=/home/marcinsz/scylla-monitoring/prometheus/scylla_servers.yml:/etc/scylla.d/prometheus/targets/scylla_manager_agents.yml
NODE_TARGET_FILE=/home/marcinsz/scylla-monitoring/prometheus/scylla_servers.yml:/etc/scylla.d/prometheus/targets/node_exporter_servers.yml
LOKI_RULE_DIR=./loki/rules/scylla
LOKI_CONF_DIR=./loki/conf
LOKI_DIR=
LOKI_PORT=3100
LOKI_WALL_DIR=./loki-wall
